local function shake(h, p, d)
 task.spawn(function()
  try(function()
   local b, t = h.CameraOffset, os.clock()
   while h.Parent and os.clock() - t < d do
    local k = 1 - (os.clock() - t) / d
    h.CameraOffset = b + V(rnd(-1, 1) * p * k, rnd(-1, 1) * p * k, 0)
    task.wait(0.03)
   end
   if h.Parent then h.CameraOffset = b end
  end)
 end)
end

local function explode(pos, who)
 local up, R, gp = V(0, 1, 0), BLAST, groundAt(pos)
 local S = R / 26
 local LAV, PUR, VIO, DEEP = rgb(240, 215, 255), rgb(190, 70, 255), rgb(120, 30, 200), rgb(60, 16, 110)
 local function tw(i, t, g) TS:Create(i, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), g):Play() end
 local function later(t, f) task.delay(t, function() try(f) end) end
 local function host(cf) return fx({Size = ball(1), Transparency = 1, CFrame = cf}, FX) end
 local function blob(dl, a, b, d0, d1, life, c0, c1, mat, tr)
  later(dl, function()
   local p = fx({Shape = BALL, Size = ball(d0), CFrame = CF(a), Color = c0, Material = mat, Transparency = tr}, FX)
   tw(p, life * 0.55, {Size = ball(d1), Position = b})
   later(life * 0.4, function() tw(p, life * 0.6, {Color = c1, Transparency = 1}) end)
   Db:AddItem(p, life + 0.3)
  end)
 end
 local function disc(dl, d1, c, tr, h, life, mat)
  later(dl, function()
   local p = fx({Shape = CYL, Size = V(h, 4, 4), CFrame = CF(gp + V(0, h / 2, 0)) * CFrame.Angles(0, 0, rad(90)), Color = c, Material = mat, Transparency = tr}, FX)
   tw(p, life, {Size = V(h * 0.6, d1, d1), Transparency = 1})
   Db:AddItem(p, life + 0.2)
  end)
 end
 local function burn(cf, class, props, off, life)
  local h = host(cf)
  local o = make(class, props, h)
  later(off, function() o.Enabled = false end)
  Db:AddItem(h, life)
 end

