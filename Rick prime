local function ball(d) return V(d, d, d) end
local function guard(f)
 return function(...)
  local ok, e = pcall(f, ...)
  if not ok then
   pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification", {Title = "Bomb error", Text = tostring(e):sub(1, 200), Duration = 20})
   end)
  end
 end
end

