local function launch(root)
 local bomb = BOMB:Clone()
 local core = bomb.PrimaryPart
 bomb.Parent = WS
 local look, pitch, cam = root.CFrame.LookVector, 0, WS.CurrentCamera
 if not server and cam then
  look = cam.CFrame.LookVector
  pitch = math.asin(math.max(-1, math.min(1, look.Y)))
 end
 local flat = V(look.X, 0, look.Z)
 flat = flat.Magnitude > 0.05 and flat.Unit or V(0, 0, -1)
 local el = math.max(rad(-5), math.min(rad(70), rad(ANGLE) + pitch * 0.6))
 bomb:PivotTo(CF(root.Position + flat * 3.2 + V(0, 1.2, 0)))
 core.AssemblyLinearVelocity = (flat * math.cos(el) + V(0, math.sin(el), 0)) * SPEED + root.AssemblyLinearVelocity
 core.AssemblyAngularVelocity = V(rnd(-14, 14), rnd(-14, 14), rnd(-14, 14))
 try(function() core:SetNetworkOwner(nil) end)
 return bomb, core
end

local function run(bomb, core, who, whoHum)
 local gl, dt = {}, {}
 for _, d in ipairs(bomb:GetDescendants()) do
  if d.Name == "StudGlow" then gl[#gl + 1] = d elseif d.Name == "StudDot" then dt[#dt + 1] = d end
 end
 local light, t0, done = core:FindFirstChildOfClass("PointLight"), os.clock(), false
 local function boom()
  if done then return end
  done = true
  local p = core.Position
  bomb:Destroy()
  explode(p, who)
 end
 core.Touched:Connect(function(hit)
  local age = os.clock() - t0
  if done or age < 0.15 then return end
  local h = humOf(hit)
  if h and h.Health > 0 and (h ~= whoHum or age > 1) then boom() end
 end)
 for _, g in ipairs(gl) do
  task.delay(rnd(0, 0.25), function()
   if g.Parent and not done then g.Material, g.Color = NEON, ON end
  end)
 end
 for _, d in ipairs(dt) do
  task.delay(rnd(0, 0.25), function()
   if d.Parent and not done then d.Material, d.Color = NEON, DOT end
  end)
 end
 if light then light.Brightness = 3 end
 local on, nxt = true, 0.3
 while not done do
  local t = os.clock() - t0
  if t >= FUSE then break end
  if not core.Parent then return end
  if t >= nxt then
   on = not on
   local f = t / FUSE
   local gc, dc = on and ON or DIM, on and DOT or DOTDIM
   if f > 0.82 then gc, dc = on and HOT or ON, on and WHITE or HOT end
   for _, g in ipairs(gl) do g.Color = gc end
   for _, d in ipairs(dt) do d.Color = dc end
   if light then light.Brightness = on and 3 + 4 * f or 1 end
   sound(core, BEEP, 0.7, 0.8 + 0.9 * f)
   nxt = t + math.max(0.06, 0.4 * (1 - f) + 0.06)
  end
  task.wait(0.03)
 end
 boom()
end

local function vis(held, v)
 for _, p in ipairs(held.parts) do
  if p.Parent then p.Transparency = v and 0 or 1 end
 end
end

local function throw(pl, tool, held)
 if held.busy then return end
 local ch = pl.Character
 local hum, root = ch and ch:FindFirstChildOfClass("Humanoid"), ch and ch:FindFirstChild("HumanoidRootPart")
 if not (hum and root) or hum.Health <= 0 then return end
 held.busy = true
 tool.Enabled = false
 make("StringValue", {Name = "toolanim", Value = "Slash"}, tool)
 task.wait(0.2)
 if hum.Health <= 0 or not root.Parent then
  held.busy = false
  return
 end
 vis(held, false)
 local ok, bomb, core = pcall(launch, root)
 if ok and bomb then task.spawn(guard(run), bomb, core, pl, hum) end
 if not tool.Parent then return end
 task.wait(COOL)
 if tool.Parent then
  vis(held, true)
  tool.Enabled = true
 end
 held.busy = false
end

local function give(pl)
 local bp = pl:FindFirstChildOfClass("Backpack") or pl:WaitForChild("Backpack", 10)
 if not bp then return end
 for _, t in ipairs(bp:GetChildren()) do
  if t.Name == NAME then t:Destroy() end
 end
 local ch = pl.Character
 local old = ch and ch:FindFirstChild(NAME)
 if old then old:Destroy() end
 local tool, held = TOOL:Clone(), {busy = false, parts = {}}
 for _, d in ipairs(tool:GetDescendants()) do
  if d:IsA("BasePart") then held.parts[#held.parts + 1] = d end
 end
 tool.Activated:Connect(guard(function() throw(pl, tool, held) end))
 tool.Parent = bp
 task.wait(0.2)
 ch = pl.Character
 local hum = ch and ch:FindFirstChildOfClass("Humanoid")
 if hum and hum.Health > 0 and tool.Parent == bp then try(function() hum:EquipTool(tool) end) end
end

local function setup(pl)
 pl.CharacterAdded:Connect(guard(function()
  task.wait(0.3)
  give(pl)
 end))
 if pl.Character then task.spawn(guard(give), pl) end
end

if server or not me then
 Pl.PlayerAdded:Connect(setup)
 for _, p in ipairs(Pl:GetPlayers()) do setup(p) end
else
 setup(me)
end
