local function make(class, props, parent)
 local i = Instance.new(class)
 for k, v in pairs(props) do i[k] = v end
 if parent then i.Parent = parent end
 return i
end
local function fx(props, parent)
 local d = {Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, CastShadow = false, Material = NEON}
 for k, v in pairs(props) do d[k] = v end
 return make("Part", d, parent)
end
local FX = WS:FindFirstChild("RickPrimeBombFX") or make("Folder", {Name = "RickPrimeBombFX"}, WS)

local function humOf(i)
 while i and i ~= WS do
  if i:IsA("Model") then
   local h = i:FindFirstChildOfClass("Humanoid")
   if h then return h, i end
  end
  i = i.Parent
 end
end

local function groundAt(pos)
 local rp = RaycastParams.new()
 rp.FilterType = Enum.RaycastFilterType.Exclude
 rp.FilterDescendantsInstances = {FX}
 local r = WS:Raycast(pos + V(0, 3, 0), V(0, -80, 0), rp)
 return r and r.Position or pos - V(0, 2.5, 0)
end

local function sound(par, id, vol, spd)
 try(function()
  local s = make("Sound", {SoundId = id, Volume = vol, PlaybackSpeed = spd, RollOffMaxDistance = 300}, par)
  s:Play()
  Db:AddItem(s, 6)
 end)
end

local function frame(n, d)
 local h = math.abs(n.Y) < 0.95 and V(0, 1, 0) or V(1, 0, 0)
 local y = (h - n * h:Dot(n)).Unit
 return CFrame.fromMatrix(n * d, n, y, n:Cross(y))
end

local function build(core, par)
 local R = SIZE / 2
 local D = math.sqrt(4 * math.pi * (R + 0.15) ^ 2 / STUDS) * 0.95
 local L = {
  {"StudBase", 0.08, 0.42 * D, rgb(18, 18, 26)}, {"StudMid", 0.04, 0.66 * D, rgb(24, 24, 34)},
  {"StudSkirt", 0.04, D, rgb(30, 30, 42)}, {"StudFace", 0.03, 0.8 * D, rgb(92, 92, 108)},
  {"StudRim", 0.025, 0.62 * D, rgb(150, 150, 166)}, {"StudGlow", 0.03, 0.48 * D, rgb(104, 104, 120)},
  {"StudDot", 0.02, 0.2 * D, rgb(150, 150, 166)},
 }
 local g = math.pi * (3 - math.sqrt(5))
 for i = 0, STUDS - 1 do
  local y = 1 - (2 * i + 1) / STUDS
  local r = math.sqrt(1 - y * y)
  local n = V(math.cos(g * i) * r, y, math.sin(g * i) * r)
  local h = -0.03
  for _, l in ipairs(L) do
   local rel = frame(n, R + h + l[2] / 2)
   h = h + l[2]
   local p = make("Part", {Name = l[1], Shape = CYL, Size = V(l[2], l[3], l[3]), Color = l[4], Material = SMOOTH, CanCollide = false, CanTouch = false, CanQuery = false, Massless = true, CastShadow = false, CFrame = core.CFrame * rel})
   make("Weld", {Part0 = core, Part1 = p, C0 = rel}, p)
   p.Parent = par
  end
 end
end

